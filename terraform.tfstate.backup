            "search": "index=aws\n| rename userIdentity.type as src_user\n| rename userIdentity.userName as user_name\n| rename requestParameters.userName as TargetUser\n| where user_name!=\"SplunkInput\"\n| bin _time span=15m \n| stats values(eventName) as APICalls, count(eventName) as CallCount by _time, user_name\n| sort by -CallCount\n| eval Enumeration=if(CallCount \u003e 100, \"Suspicious\", \"N/A\")\n| addinfo\n| eval rule_description=urldecode(\"This+detection+identifies+users+who+are+making+a+large+number+of+API+calls+in+a+short+period+of+time.+This+could+indicate+automation+or+malicious+activity%0Athrough+probing%2C+reconnaissance%2C+or+enumeration+of+our+environment.\")\n| eval trigger_range=strftime(info_min_time, \"%Y-%m-%d %H:%M:%S %Z\").\" to \".strftime(info_max_time, \"%Y-%m-%d %H:%M:%S %Z\")\n| eval query=urldecode(\"index%3Daws%0A%7C+rename+userIdentity.type+as+src_user%0A%7C+rename+userIdentity.userName+as+user_name%0A%7C+rename+requestParameters.userName+as+TargetUser%0A%7C+where+user_name%21%3D%22SplunkInput%22%0A%7C+bin+_time+span%3D15m+%0A%7C+stats+values%28eventName%29+as+APICalls%2C+count%28eventName%29+as+CallCount+by+_time%2C+user_name%0A%7C+sort+by+-CallCount%0A%7C+eval+Enumeration%3Dif%28CallCount+%3E+100%2C+%22Suspicious%22%2C+%22N%2FA%22%29\")\n| fields rule_description trigger_range query\n",
