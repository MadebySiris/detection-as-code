            "description": "This detection looks for anomalous access denied errors in AWS CloudTrail logs.\nIt uses statistical anomaly detection to identify unusual spikes in access denied events,\nwhich could indicate potential security threats or misconfigurations in the AWS environment.\n",
            "disabled": false,
            "dispatch_buckets": 0,
            "dispatch_earliest_time": "-12h",
            "dispatch_index_earliest": "",
            "dispatch_index_latest": "",
            "dispatch_indexed_realtime": false,
            "dispatch_indexed_realtime_minspan": 0,
            "dispatch_indexed_realtime_offset": 0,
            "dispatch_latest_time": "now",
            "dispatch_lookups": false,
            "dispatch_max_count": 500000,
            "dispatch_max_time": 0,
            "dispatch_reduce_freq": 10,
            "dispatch_rt_backfill": false,
            "dispatch_rt_maximum_span": 0,
            "dispatch_spawn_process": false,
            "dispatch_time_format": "%FT%T.%Q%:z",
            "dispatch_ttl": "2p",
            "display_view": "",
            "id": "Detecting Anomalous Access Denied Errors Code1",
            "ignore_schedule_priority": false,
            "is_scheduled": true,
            "is_visible": true,
            "max_concurrent": 1,
            "name": "Detecting Anomalous Access Denied Errors Code1",
            "realtime_schedule": false,
            "request_ui_dispatch_app": "",
            "request_ui_dispatch_view": "",
            "restart_on_searchpeer_add": false,
            "run_on_startup": false,
            "schedule_priority": "default",
            "schedule_window": "0",
            "search": "index=aws errorCode=\"AccessDenied\" earliest=-30d latest=now()\n | bin _time span=15m\n | rename userIdentity.userName as user_name\n | search userIdentity.arn != \"*SplunkInput\"\n\n | stats\n   count                        as access_denied_count\n   values(eventName)            as eventName\n   values(errorMessage)         as error_messages\n   values(user_agent)           as useragent\n   dc(eventName)                as unique_apis\n by _time, aws_account_id, sourceIPAddress, userIdentity.arn\n    \n| anomalydetection\n   access_denied_count\n   action=annotate\n   BY aws_account_id sourceIPAddress userIdentity.arn\n| eval isOutlier = if(probable_cause != \"\", \"1\", \"0\")\n| where isnotnull(probable_cause)\n| addinfo\n| eval rule_description=urldecode(\"This+detection+looks+for+anomalous+access+denied+errors+in+AWS+CloudTrail+logs.%0AIt+uses+statistical+anomaly+detection+to+identify+unusual+spikes+in+access+denied+events%2C%0Awhich+could+indicate+potential+security+threats+or+misconfigurations+in+the+AWS+environment.\")\n| eval trigger_range=strftime(info_min_time, \"%Y-%m-%d %H:%M:%S %Z\").\" to \".strftime(info_max_time, \"%Y-%m-%d %H:%M:%S %Z\")\n| eval query=urldecode(\"index%3Daws+errorCode%3D%22AccessDenied%22+earliest%3D-30d+latest%3Dnow%28%29%0A+%7C+bin+_time+span%3D15m%0A+%7C+rename+userIdentity.userName+as+user_name%0A+%7C+search+userIdentity.arn+%21%3D+%22%2ASplunkInput%22%0A%0A+%7C+stats%0A+++count++++++++++++++++++++++++as+access_denied_count%0A+++values%28eventName%29++++++++++++as+eventName%0A+++values%28errorMessage%29+++++++++as+error_messages%0A+++values%28user_agent%29+++++++++++as+useragent%0A+++dc%28eventName%29++++++++++++++++as+unique_apis%0A+by+_time%2C+aws_account_id%2C+sourceIPAddress%2C+userIdentity.arn%0A++++%0A%7C+anomalydetection%0A+++access_denied_count%0A+++action%3Dannotate%0A+++BY+aws_account_id+sourceIPAddress+userIdentity.arn%0A%7C+eval+isOutlier+%3D+if%28probable_cause+%21%3D+%22%22%2C+%221%22%2C+%220%22%29%0A%7C+where+isnotnull%28probable_cause%29\")\n| fields rule_description trigger_range query\n",
            "vsid": "",
            "workload_pool": ""
