            "cron_schedule": "*/5 * * * *",
            "description": "This detection identifies unexpected processes that are making network connections.\nIt looks for processes that are not typically associated with network activity, such as system processes or known benign applications,\nand flags them for further investigation.\n",
            "disabled": false,
            "dispatch_buckets": 0,
            "dispatch_earliest_time": "-12h",
            "dispatch_index_earliest": "",
            "dispatch_index_latest": "",
            "dispatch_indexed_realtime": false,
            "dispatch_indexed_realtime_minspan": 0,
            "dispatch_indexed_realtime_offset": 0,
            "dispatch_latest_time": "now",
            "dispatch_lookups": false,
            "dispatch_max_count": 500000,
            "dispatch_max_time": 0,
            "dispatch_reduce_freq": 10,
            "dispatch_rt_backfill": false,
            "dispatch_rt_maximum_span": 0,
            "dispatch_spawn_process": false,
            "dispatch_time_format": "%FT%T.%Q%:z",
            "dispatch_ttl": "2p",
            "display_view": "",
            "id": "Unexpected process makes network connection1",
            "ignore_schedule_priority": false,
            "is_scheduled": true,
            "is_visible": true,
            "max_concurrent": 1,
            "name": "Unexpected process makes network connection1",
            "realtime_schedule": false,
            "request_ui_dispatch_app": "",
            "request_ui_dispatch_view": "search",
            "restart_on_searchpeer_add": false,
            "run_on_startup": false,
            "schedule_priority": "default",
            "schedule_window": "0",
            "search": "index=* EventCode=3\n| sort 0 _time\n| streamstats current=f last(_time) as previous_time by host, process_guid, src_ip, dest_ip\n| eval interval_seconds=round(_time-previous_time, 2)\n| table _time src_ip dest_ip process_name interval_seconds, process_guid, host\n| eval suspicious_level = case(\n  process_name == \"MpDefenderCoreService.exe\", \"Low\",\n  process_name = \"OneDrive.Sync.Service.exe\", \"Low\",\n  process_name = \"chrome.exe\", \"Low\",\n  process_name = \"svchost.exe\", \"Low\",\n  true(), \"High\"\n  )\n| addinfo\n| eval rule_description=urldecode(\"This+detection+identifies+unexpected+processes+that+are+making+network+connections.%0AIt+looks+for+processes+that+are+not+typically+associated+with+network+activity%2C+such+as+system+processes+or+known+benign+applications%2C%0Aand+flags+them+for+further+investigation.\")\n| eval trigger_range=strftime(info_min_time, \"%Y-%m-%d %H:%M:%S %Z\").\" to \".strftime(info_max_time, \"%Y-%m-%d %H:%M:%S %Z\")\n| eval query=urldecode(\"index%3D%2A+EventCode%3D3%0A%7C+sort+0+_time%0A%7C+streamstats+current%3Df+last%28_time%29+as+previous_time+by+host%2C+process_guid%2C+src_ip%2C+dest_ip%0A%7C+eval+interval_seconds%3Dround%28_time-previous_time%2C+2%29%0A%7C+table+_time+src_ip+dest_ip+process_name+interval_seconds%2C+process_guid%2C+host%0A%7C+eval+suspicious_level+%3D+case%28%0A++process_name+%3D%3D+%22MpDefenderCoreService.exe%22%2C+%22Low%22%2C%0A++process_name+%3D+%22OneDrive.Sync.Service.exe%22%2C+%22Low%22%2C%0A++process_name+%3D+%22chrome.exe%22%2C+%22Low%22%2C%0A++process_name+%3D+%22svchost.exe%22%2C+%22Low%22%2C%0A++true%28%29%2C+%22High%22%0A++%29\")\n| fields rule_description trigger_range query\n",
            "vsid": "",
            "workload_pool": ""
