            "cron_schedule": "*/5 * * * *",
            "description": "This detection identifies processes that have loaded unsigned DLLs and are also making network connections.\nThis could indicate malicious activity, as unsigned DLLs may be used to inject malicious code into legitimate processes,\nand network activity could be used for data exfiltration or command and control communication.\n",
            "disabled": false,
            "dispatch_buckets": 0,
            "dispatch_earliest_time": "-12h",
            "dispatch_index_earliest": "",
            "dispatch_index_latest": "",
            "dispatch_indexed_realtime": false,
            "dispatch_indexed_realtime_minspan": 0,
            "dispatch_indexed_realtime_offset": 0,
            "dispatch_latest_time": "now",
            "dispatch_lookups": false,
            "dispatch_max_count": 500000,
            "dispatch_max_time": 0,
            "dispatch_reduce_freq": 10,
            "dispatch_rt_backfill": false,
            "dispatch_rt_maximum_span": 0,
            "dispatch_spawn_process": false,
            "dispatch_time_format": "%FT%T.%Q%:z",
            "dispatch_ttl": "2p",
            "display_view": "",
            "id": "Unsigned DLL Load and Network Activity in the Same Process1",
            "ignore_schedule_priority": false,
            "is_scheduled": true,
            "is_visible": true,
            "max_concurrent": 1,
            "name": "Unsigned DLL Load and Network Activity in the Same Process1",
            "realtime_schedule": false,
            "request_ui_dispatch_app": "",
            "request_ui_dispatch_view": "",
            "restart_on_searchpeer_add": false,
            "run_on_startup": false,
            "schedule_priority": "default",
            "schedule_window": "0",
            "search": "index=* EventCode IN (3, 7)\n| eval unsigned_dll=if(\n    EventCode=7\n    AND lower(Signed)=\"false\"\n    AND like(lower(ImageLoaded), \"%.dll\"),\n    ImageLoaded,\n    null()\n  )\n| bin _time span=15m\n| stats\n    count(eval(EventCode=3)) as network_connections\n    values(unsigned_dll) as unsigned_dlls\n    values(Image) as process_path\n    values(dest_ip) as destinations\n    by _time host ProcessGuid\n| where network_connections \u003e 0 AND mvcount(unsigned_dlls) \u003e 0\n| eval priority=\"Suspicious — unsigned DLL load and network activity\"\n| addinfo\n| eval rule_description=urldecode(\"This+detection+identifies+processes+that+have+loaded+unsigned+DLLs+and+are+also+making+network+connections.%0AThis+could+indicate+malicious+activity%2C+as+unsigned+DLLs+may+be+used+to+inject+malicious+code+into+legitimate+processes%2C%0Aand+network+activity+could+be+used+for+data+exfiltration+or+command+and+control+communication.\")\n| eval trigger_range=strftime(info_min_time, \"%Y-%m-%d %H:%M:%S %Z\").\" to \".strftime(info_max_time, \"%Y-%m-%d %H:%M:%S %Z\")\n| eval query=urldecode(\"index%3D%2A+EventCode+IN+%283%2C+7%29%0A%7C+eval+unsigned_dll%3Dif%28%0A++++EventCode%3D7%0A++++AND+lower%28Signed%29%3D%22false%22%0A++++AND+like%28lower%28ImageLoaded%29%2C+%22%25.dll%22%29%2C%0A++++ImageLoaded%2C%0A++++null%28%29%0A++%29%0A%7C+bin+_time+span%3D15m%0A%7C+stats%0A++++count%28eval%28EventCode%3D3%29%29+as+network_connections%0A++++values%28unsigned_dll%29+as+unsigned_dlls%0A++++values%28Image%29+as+process_path%0A++++values%28dest_ip%29+as+destinations%0A++++by+_time+host+ProcessGuid%0A%7C+where+network_connections+%3E+0+AND+mvcount%28unsigned_dlls%29+%3E+0%0A%7C+eval+priority%3D%22Suspicious+%E2%80%94+unsigned+DLL+load+and+network+activity%22\")\n| fields rule_description trigger_range query\n",
            "vsid": "",
            "workload_pool": ""
